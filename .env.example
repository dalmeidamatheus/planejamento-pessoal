# Configure estas variáveis em Vercel > Project > Settings > Environment Variables

# --- Login e dados por usuário (Supabase > Settings > API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-public

# --- Monitor de preços da lista de desejos (cron diário) ---
# service_role é SECRETA: só no servidor, nunca no front-end. Supabase > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=
# Qualquer texto longo e aleatório (ex.: saída de `openssl rand -hex 24`). A Vercel o envia ao cron.
CRON_SECRET=

# --- Opcional: resumo de reuniões com IA (/api/summarize). Sem isto o app usa o resumo local ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
