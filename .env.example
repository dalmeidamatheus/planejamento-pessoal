# Configure estas variáveis em Vercel > Project > Settings > Environment Variables

# --- Login e dados por usuário (Supabase > Settings > API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-public

# --- Monitor de preços da lista de desejos (cron diário) ---
# service_role é SECRETA: só no servidor, nunca no front-end. Supabase > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=
# Qualquer texto longo e aleatório (ex.: saída de `openssl rand -hex 24`). A Vercel o envia ao cron.
CRON_SECRET=

# --- Opcional: recursos de IA. Sem nenhuma chave o app funciona nos modos gratuitos do navegador ---
# Resumo de reuniões e foto -> texto. GRATUITO: crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Alternativa PAGA por uso (só usada se GEMINI_API_KEY estiver vazia)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Transcrição de voz mais precisa (Whisper). GRATUITO: crie a chave em https://console.groq.com/keys
GROQ_API_KEY=
# Alternativa PAGA por uso (só usada se GROQ_API_KEY estiver vazia)
OPENAI_API_KEY=
TRANSCRIBE_MODEL=
