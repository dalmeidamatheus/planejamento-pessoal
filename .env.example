# Configure estas variáveis em Vercel > Project > Settings > Environment Variables

# --- Login e dados por usuário (Supabase > Settings > API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-public

# --- Monitor de preços da lista de desejos (cron diário) ---
# service_role é SECRETA: só no servidor, nunca no front-end. Supabase > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=
# Qualquer texto longo e aleatório (ex.: saída de `openssl rand -hex 24`). A Vercel o envia ao cron.
CRON_SECRET=

# --- Opcional: recursos de IA, com FALLBACK AUTOMATICO do melhor para o pior ---
# O app usa o primeiro provedor configurado de cada lista; se falhar ou a cota acabar, passa para o proximo.
# No fim ha sempre uma reserva gratuita que roda no navegador. Nenhuma chave e obrigatoria.
#
# FOTO -> TEXTO (OCR), nesta ordem:  Claude (pago) > Gemini > Mistral OCR > Groq Llama 4 Scout > OpenRouter > OCR.space > Tesseract no navegador
# RESUMO DE REUNIAO, nesta ordem:    Claude (pago) > Gemini > Groq Llama 3.3 > Mistral > OpenRouter > resumo local
# VOZ -> TEXTO, nesta ordem:         Groq Whisper > OpenAI (pago) > AssemblyAI > Mistral Voxtral > Cloudflare > Whisper local no navegador > reconhecimento do navegador

ANTHROPIC_API_KEY=            # pago por uso - https://console.anthropic.com
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=               # gratuito - https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=                 # gratuito (texto, visao e Whisper) - https://console.groq.com/keys
MISTRAL_API_KEY=              # gratuito (OCR, texto e Voxtral) - https://console.mistral.ai/api-keys
OPENROUTER_API_KEY=           # gratuito (modelos :free) - https://openrouter.ai/keys
OCRSPACE_API_KEY=             # gratuito (25 mil/mes, imagem de ate 1 MB) - https://ocr.space/ocrapi/freekey
OPENAI_API_KEY=               # pago por uso (Whisper) - https://platform.openai.com/api-keys
ASSEMBLYAI_API_KEY=           # credito gratuito inicial - https://www.assemblyai.com
CLOUDFLARE_ACCOUNT_ID=        # gratuito (cota diaria) - https://dash.cloudflare.com
CLOUDFLARE_API_TOKEN=
